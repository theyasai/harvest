  "fixes": [
    {"floor": "1F", "at": [3640, 5000], "title": "階段がなくなる",
     "before": "階段と2Fの階段まわりで約8m²を使い、毎日上り下りが必要です。",
     "after": "上下移動がなく、家じゅうを同じ床の高さで回れます。年を取っても暮らし方を変えずに済みます。"},
    {"floor": "1F", "at": [7280, 6370], "title": "中庭を家の真ん中に",
     "before": "中庭は西寄りで、2Fホールの下は屋根がかかって暗くなります。",
     "after": "約30m²（18帖）の中庭を、廊下・和室・LDK・土間でぐるりと囲みました。どの部屋からも中庭が見え、光と風が入ります。"},
    {"floor": "1F", "at": [6500, 11800], "title": "玄関を土間ひとつに",
     "before": "土間の玄関と、西南の家族用玄関の2つがあります。",
     "after": "南の土間をひとつの玄関にしました。土間からは東へ行けばLDK、西へ行けば廊下を通って洗面・寝室です。家族はLDKを通らずに手を洗いに行けます。"},
    {"floor": "1F", "at": [1365, 6800], "title": "水回りを西側にまとめた",
     "before": "洗濯機は1F、浴室と洗面は2Fで、洗濯物を持って階段を上り下りします。",
     "after": "洗面脱衣とランドリーを1室にまとめました。脱いで、洗って、しまうまでが一部屋で済みます。"},
    {"floor": "1F", "at": [1820, 11800], "title": "外気浴は坪庭で",
     "before": "2Fのホールに椅子を置いて外気浴をする計画です。",
     "after": "浴室と岩盤浴から、塀で囲った屋外の坪庭に直接出られます。外から見えない場所で、本当に外の空気に当たれます。"},
    {"floor": "1F", "at": [1820, 1800], "title": "寝室まわりを北西に",
     "before": "寝室の真上が2FのLDKで、足音が響きます。",
     "after": "寝室の上に部屋がないので静かです。WICは寝室と廊下の両側から入れる通り抜け型にしました。"},
    {"floor": "1F", "at": [8645, 1800], "title": "和室を客間と兼用",
     "before": "1Fの客間（6帖）と2Fの和室（4.7帖）が別々にあります。",
     "after": "LDKの隣に6帖の和室をひとつ置き、客間と兼ねます。引き戸を開ければLDKと続き、中庭も見えます。"},
    {"floor": "1F", "at": [13500, 16300], "title": "敷地と駐車場",
     "before": "敷地は約9×12.5mで、車を置く場所がありません。",
     "after": "敷地を約20.5×21.7m（約135坪）にし、南東に2台分の駐車場を取りました。"}
  ],
  "notes": [
    "延床は約161m²（約49坪）、建物の外寸は15.5×12.7mです。建ぺい率は約44%で、一般的な住宅地の上限（50〜60%）に収まります。",
    "平屋は2階建てより基礎と屋根が約2倍の広さになるため、同じ延床面積でも建築費が1〜2割高くなりがちです。",
    "中庭を囲む形は外壁が長くなります。断熱、中庭の排水、窓の数によるコストを設計者と確認してください。",
    "屋根は平らな陸屋根で描いています。平屋では、片流れなど勾配のある屋根にすると雨漏りの心配が減ります。",
    "2階建ての案から、1Fのミニキッチン、2Fのシャワー室（浴室で兼用）、ユーティリティ、客間（和室で兼用）、2Fホールを省いています。"
  ],
